# Rumi Messenger deploy config. Copy to deploy/.env (scripts/setup.sh does this automatically).

# The Matrix server_name. This is baked into every user id (@user:SERVER_NAME) and room alias
# at generation time -- changing it later requires regenerating the homeserver. Use your real
# domain in production (e.g. chat.rumi.school); "localhost" is fine for local testing.
SERVER_NAME=localhost

# The URL Matrix clients (Element Web, Element X, rumi-platform's bot) use to reach Synapse.
# Must be reachable from wherever those clients run. For local testing this is
# http://localhost:${SYNAPSE_PORT}; in production this is your public https:// URL (the one
# Caddy terminates TLS for).
PUBLIC_BASE_URL=http://localhost:8008

# Host port Synapse's client-server API is bound to (container always listens on 8008 internally).
SYNAPSE_PORT=8008

# Host port Element Web is served on (container always listens on 80 internally).
ELEMENT_PORT=8082

# Address Synapse/Element ports are bound to on the host. 127.0.0.1 keeps them off the network
# until Caddy (profile "prod"/"tls") fronts them with a real domain + TLS. LEAVE THIS AT
# 127.0.0.1 EVEN IN PRODUCTION -- Caddy reaches Synapse/Element over the internal Docker network
# (service names, e.g. "synapse:8008"), never via this host-published port, so widening it to
# 0.0.0.0 buys nothing except letting anyone on the internet skip Caddy (and its TLS/rate
# limiting) and hit Synapse/Element directly. Only Caddy's own 80/443 (docker-compose.yml, always
# published on all interfaces) need to be reachable from outside. See docs/RUNBOOK.md.
BIND_ADDR=127.0.0.1

# The Matrix identity/federation domain -- this IS server_name (see SERVER_NAME above) and is
# where Caddy (profile "prod"/"tls") serves .well-known/matrix/{server,client}. Defaults to
# SERVER_NAME if left blank; only set it separately if you deliberately want the literal string
# passed to Caddy to differ (you almost never do -- well-known discovery for federation/clients
# must live at the SERVER_NAME domain). scripts/setup.sh writes this in automatically.
#PUBLIC_DOMAIN=

# The domain Element Web (the actual app UI) is served on. Defaults to PUBLIC_DOMAIN, i.e. one
# domain serving everything (the simplest, most common small-deployment shape -- what
# matrix.org's own "Synapse behind Caddy" reference does). Set this to a different domain (e.g.
# "app.yourschool.org" while PUBLIC_DOMAIN stays "yourschool.org") if you want the web client on
# its own subdomain; Caddy (deploy/Caddyfile) serves both domains from the one site block either
# way, so this is safe to leave unset.
#ELEMENT_DOMAIN=

# Caddy's per-site `tls` directive argument (profile "prod"/"tls" only). Leave blank in real
# production -- Caddy then manages a real Let's Encrypt certificate automatically, which needs
# ports 80/443 reachable from the internet for the ACME challenge. Set to "internal" to make
# Caddy mint its own self-signed cert instead, for proving the whole TLS path works on a machine
# with no public DNS/domain (see docs/RUNBOOK.md's "go live" checklist) -- browsers/curl will
# warn/refuse it (`curl -k` to override) since it's not from a public CA, which is expected and
# is exactly what marks it as a local-only proof, never something to leave set in production.
#CADDY_TLS_MODE=

# How many timestamped folders scripts/backup.sh keeps under backups/ before deleting the
# oldest. Sized for "run backup.sh nightly via cron/systemd timer" (see docs/RUNBOOK.md) --
# 14 days at that cadence, tune to your retention needs/disk budget.
BACKUP_KEEP_N=14

# Postgres password for the synapse role. Generated randomly by setup.sh if left blank/unset
# in a fresh .env.
POSTGRES_PASSWORD=

# Password for the @rumi bot account. Generated randomly by setup.sh if left blank.
RUMI_BOT_PASSWORD=

# Username for the initial Synapse admin account (created by setup.sh via the shared-secret
# registrar). Not a Matrix-wide concept -- just this deployment's admin.
ADMIN_USER=admin

# Admin account password. Generated randomly by setup.sh if left blank; printed ONCE at the end
# of setup, never stored in plaintext anywhere else.
ADMIN_PASSWORD=

# How new users can create accounts:
#   token -> (default) the admin creates teacher accounts (scripts/teacher.sh); self sign-up
#            needs a one-time registration token minted via the admin API
#   open  -> anyone who can reach Synapse can register (only for a throwaway test server)
REGISTRATION_MODE=token

# coturn (TURN relay for 1:1 audio/video calls, issue #1). Because coturn runs with
# network_mode: host (see docs/ARCHITECTURE.md / docker-compose.yml), these three are NOT
# remapped per docker-compose project the way SYNAPSE_PORT/ELEMENT_PORT are -- two checkouts
# running side by side (COMPOSE_PROJECT_NAME below) will collide on TURN_PORT and the relay
# range unless you change these for the second one, or don't run coturn there at all. Defaults
# are coturn's/Matrix's own documented defaults (element-hq/synapse docs/setup/turn/coturn.md).
TURN_PORT=3478
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535

# Shared secret coturn and Synapse both derive short-lived, per-call TURN credentials from
# (coturn's --static-auth-secret / Synapse's turn_shared_secret, the TURN REST API mechanism --
# see docs/ARCHITECTURE.md). Generated randomly by setup.sh if left blank. Same trust tier as
# POSTGRES_PASSWORD/REG_SHARED_SECRET above: real secret material, gitignored, chmod 600.
TURN_SHARED_SECRET=

# Public IP address (or hostname) coturn should tell clients to use for the actual media relay,
# for when this host is behind NAT (a cloud VM's private IP, a home router, etc). Leave blank
# for local/private-network testing -- coturn then relays over whatever local address received
# the request, which is correct there but USELESS for real cross-network calling. See
# docs/RUNBOOK.md's calling section: this is the same "BIND_ADDR=127.0.0.1 is fine for local
# testing, useless for production" gap the rest of this stack already documents, closed by the
# production-hardening work tracked in issue #6.
#TURN_EXTERNAL_IP=

# docker compose project name. Set this to run a second, fully independent copy of this stack
# (different volumes/network) side by side with another checkout -- e.g. for a
# verification/staging run -- without the two sharing Postgres/Synapse data. Leave unset for the
# default "rumi-messenger" project.
#COMPOSE_PROJECT_NAME=rumi-messenger

# Container name prefix (rumi-postgres/rumi-synapse/rumi-element/rumi-caddy by default).
# `container_name` is fixed regardless of COMPOSE_PROJECT_NAME (Docker doesn't derive it from
# the project automatically the way volume/network names are), so if you're running two stacks
# on one Docker host at once (e.g. alongside a verification run), also set this to something
# unique -- it does NOT need to match COMPOSE_PROJECT_NAME.
#RUMI_CONTAINER_PREFIX=rumi

# Push, no-Google path (issue #3): self-hosted ntfy = UnifiedPush server + Matrix push gateway,
# started by scripts/push-setup.sh (compose profile "push"). See docs/PUSH.md.
# The URL phones AND Synapse use for ntfy. Its own hostname (needs a DNS A record); Caddy serves it
# as NTFY_DOMAIN. Default: https://ntfy.<PUBLIC_DOMAIN>. Must resolve to a PUBLIC IP from inside
# the Synapse container -- Synapse refuses to push to private addresses (docs/PUSH.md).
#NTFY_BASE_URL=https://ntfy.chat.example.org
#NTFY_DOMAIN=ntfy.chat.example.org
# Host port ntfy is bound to (on BIND_ADDR).
NTFY_PORT=2586
# true behind Caddy (default); false only when phones hit the port directly (local emulator proof).
#NTFY_BEHIND_PROXY=true

# Push notifications on phones (Sygnal push gateway, issue #3). Off by default -- the "push"
# compose profile (`docker compose --profile push up -d sygnal`) and scripts/push-setup.sh are
# what actually start it. See docs/PUSH.md for the full picture, including what still needs a
# human (a Firebase project, a service account JSON, and a signed/sideloaded Android build) even
# after every var below is set.

# Host port Sygnal's Push Gateway API (POST /_matrix/push/v1/notify, GET /health) is bound to
# (container always listens on 5000 internally).
SYGNAL_PORT=5000

# The Android app id Sygnal registers as a pushkin (FCM "gcm" pushkin, api_version v1). Must
# match the fork's applicationId (element-x-android plugins/src/main/kotlin/config/
# BuildTimeConfig.kt: APPLICATION_ID = "ai.hellorumi.messenger") for a release build;
# scripts/push-setup.sh also registers "<this>.debug" automatically for debug builds, same
# credentials, no separate var needed.
PUSH_APP_ID=ai.hellorumi.messenger

# Path (on the host running scripts/push-setup.sh) to the Firebase service account JSON key for
# the FCM v1 API. THIS IS A PLACEHOLDER PATH -- no such file is created by this repo, and
# push-setup.sh will not fabricate one. Get a real one from the Firebase console (Project
# Settings -> Service accounts -> Generate new private key) for the project backing
# PUSH_APP_ID's google-services.json (see docs/PUSH.md for the exact three manual steps).
# push-setup.sh refuses to start Sygnal with a working FCM pushkin until a real, valid
# service-account JSON exists at this path -- until then it renders sygnal.yaml with the app
# section commented out and Sygnal starts with zero configured apps (see docs/PUSH.md).
FCM_SERVICE_ACCOUNT_JSON=./sygnal/fcm-service-account.json

# Calls (issues #1 + #2, LiveKit SFU + lk-jwt-service + calls-proxy). ON by default: setup.sh starts
# them and advertises them to clients through Synapse. The phone app can ONLY call through these,
# so CALLS=off means no calls from phones at all (the web app keeps legacy 1:1 calls via coturn).
# See docs/CALLING.md.
CALLS=on

# LiveKit's own API key/secret pair, generated randomly by setup.sh if left blank. Shared between
# the livekit service and lk-jwt-service -- lk-jwt-service mints per-participant JWTs signed with
# this secret, livekit-server verifies them.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Host ports for the LiveKit SFU: signalling (WS/HTTP), TCP media fallback, and the UDP media
# relay range (one port per active call leg per participant, same shape as coturn's
# TURN_MIN_PORT-TURN_MAX_PORT above but a much smaller range -- see docs/CALLING.md for the
# capacity math this implies).
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_MIN=50100
LIVEKIT_RTC_UDP_MAX=50200

# Host port for lk-jwt-service's own HTTP API (container always listens on 8080 internally).
LIVEKIT_JWT_PORT=8180

# Public addresses CLIENTS (browsers, phones) are given for calls. Leave blank: setup.sh derives
# them from PUBLIC_BASE_URL -- https -> https://PUBLIC_DOMAIN/livekit/jwt + wss://PUBLIC_DOMAIN/livekit/sfu
# (the "prod" Caddy); plain http (dev) -> http://<host>:LIVEKIT_JWT_PORT + ws://<host>:LIVEKIT_PORT.
# Never the Docker-internal "lk-jwt-service"/"livekit" names -- a phone cannot resolve those
# (OPEN_ID_ERROR in the call lobby).
LIVEKIT_SERVICE_URL=
LIVEKIT_WS_URL=
# IP LiveKit advertises for call media (ICE). Blank = the container's bridge IP, reachable only
# from this host. Set to the server's LAN or public IP for phones/other machines.
LIVEKIT_NODE_IP=
# Host address the LiveKit MEDIA ports (LIVEKIT_RTC_TCP_PORT + the UDP range) bind to. Blank =
# BIND_ADDR (local only). Production: 0.0.0.0, and open those ports in the firewall.
LIVEKIT_MEDIA_BIND_ADDR=
