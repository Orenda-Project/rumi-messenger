# Rumi Messenger TLS front door -- only used with `docker compose --profile prod up -d` (older
# alias: `--profile tls`). PUBLIC_DOMAIN/ELEMENT_DOMAIN/CADDY_TLS_MODE come from deploy/.env
# (scripts/setup.sh writes PUBLIC_DOMAIN/ELEMENT_DOMAIN in for you, defaulted from SERVER_NAME).
#
# Serves, on BOTH domains (the common case is PUBLIC_DOMAIN == ELEMENT_DOMAIN, one address doing
# everything; setting ELEMENT_DOMAIN differently just adds a second hostname to the same rules):
#   https://{$PUBLIC_DOMAIN}(/{$ELEMENT_DOMAIN})  -> Element Web (the app) at "/"
#   .../_matrix, /_synapse                        -> Synapse (client-server + media + federation)
#   .../.well-known/matrix/*                       -> server discovery -- MUST resolve at the
#                                                      literal Matrix server_name (PUBLIC_DOMAIN)
#                                                      for federation/clients to find Synapse;
#                                                      harmless to also serve on ELEMENT_DOMAIN.
#
# `tls {$CADDY_TLS_MODE}` -- blank (production default) is a bare `tls` directive, same as
# omitting it: Caddy manages a real Let's Encrypt cert automatically (needs 80/443 reachable from
# the internet for ACME). Set CADDY_TLS_MODE=internal for a local self-signed proof with no
# public DNS -- see docs/RUNBOOK.md.

{$PUBLIC_DOMAIN}, {$ELEMENT_DOMAIN} {
	tls {$CADDY_TLS_MODE}

	handle /.well-known/matrix/server {
		header Content-Type application/json
		respond `{"m.server": "{$PUBLIC_DOMAIN}:443"}` 200
	}

	handle /.well-known/matrix/client {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		# No org.matrix.msc4143.rtc_foci here on purpose: both apps discover the calls backend from
		# Synapse's MSC4143 /rtc/transports, which scripts/setup.sh writes only when it actually
		# started LiveKit (CALLS=off -> nothing advertised). One source, never a dead address.
		respond `{"m.homeserver": {"base_url": "https://{$PUBLIC_DOMAIN}"}, "m.identity_server": {"base_url": "https://vector.im"}}` 200
	}

	# Calls (issue #2): proxies to lk-jwt-service, prefix stripped (its routes -- /sfu/get,
	# /get_token, /healthz -- live at its root). lk-jwt-service shares calls-proxy's network
	# namespace (docker-compose.yml), so the upstream name is calls-proxy. 502 if CALLS=off.
	handle_path /livekit/jwt/* {
		reverse_proxy calls-proxy:8080
	}

	# LiveKit SFU signalling (issue #2), proxied so the browser gets a real wss:// connection
	# through Caddy's own TLS cert instead of a raw plaintext port -- Caddy's reverse_proxy
	# handles the WebSocket upgrade transparently. This is also how lk-jwt-service itself reaches
	# LiveKit for its own room-management calls (LIVEKIT_URL in docker-compose.yml points here,
	# not at livekit:7880 directly) -- it has no other route to "PUBLIC_DOMAIN" from inside its
	# own container. See docs/CALLING.md.
	handle_path /livekit/sfu/* {
		reverse_proxy livekit:7880
	}

	handle /_matrix/* {
		reverse_proxy synapse:8008
	}

	handle /_synapse/* {
		reverse_proxy synapse:8008
	}

	handle {
		reverse_proxy element:80
	}
}

# Push (issue #3): self-hosted ntfy = UnifiedPush distributor server + Matrix push gateway.
# Its own hostname because the app discovers the gateway at the endpoint host's root
# /_matrix/push/v1/notify, which on PUBLIC_DOMAIN is Synapse's. Only answers with the "push"
# profile up (502 otherwise). Must match NTFY_BASE_URL. See docs/PUSH.md.
{$NTFY_DOMAIN} {
	tls {$CADDY_TLS_MODE}
	reverse_proxy ntfy:80
}
